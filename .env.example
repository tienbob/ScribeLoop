# Optional summaries: use an OpenAI-compatible chat/completions API.
# Base URL includes the API prefix (usually /v1), not /chat/completions.
SUMMARY_BASE_URL=
SUMMARY_MODEL=
SUMMARY_API_KEY=
SUMMARY_PROVIDER=
# Remote endpoints require HTTPS and a key. Loopback HTTP may omit a key.
# Restart the app after changing settings. Never commit your real .env.
